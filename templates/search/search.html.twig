{% extends 'base.html.twig' %}

{% block content %}
    <h2>Affichage de {{ hits|length }} résultats pour "{{ query }}"</h2>

    <ul>
        {% for i, hit in hits %}
            <li>
                <a href="{{ hit.document.url }}">
                    {{- hit.document.title -}}
                </a>
            </li>
        {% endfor %}
    </ul>
{% endblock %}
