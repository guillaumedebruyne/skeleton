{% extends 'base.html.twig' %}

{% block title %}Session Basthon{% endblock %}

{% block content %}
    <h2>Lancer une session Basthon</h2>
    <button id="launchBasthon">Lancer Basthon</button>
    <div id="iframe-container"></div>
    <div id="loader" style="display:none;">⏳ Démarrage de l’environnement...</div>
    <div id="error" style="color:red;"></div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.getElementById("launchBasthon").addEventListener("click", () => {
            const loader = document.getElementById("loader");
            const errorBox = document.getElementById("error");
            const container = document.getElementById("iframe-container");

            loader.style.display = "block";
            errorBox.innerText = "";
            container.innerHTML = "";

            // Timeout si le backend met trop de temps à répondre
            const timeout = (ms) => new Promise((_, reject) =>
                setTimeout(() => reject(new Error("Le démarrage est trop long")), ms)
            );

            function get() {
                Promise.race([
                    fetch(`/basthon/start/{{ session_id }}`).then(r => r.json()),
                    timeout(10000) // timeout à 10 secondes
                ])
                    .then(data => {
                        if (data.error || !data.iframe_url) {
                            throw new Error(data.error || "Réponse invalide");
                        }

                        const iframe = document.createElement("iframe");
                        iframe.src = data.iframe_url;
                        iframe.width = "100%";
                        iframe.height = "800";
                        iframe.frameBorder = "0";
                        container.appendChild(iframe);
                    })
                    .catch(err => {
                        errorBox.innerText = "❌ Erreur : " + err.message;
                    })
                    .finally(() => {
                        loader.style.display = "none";
                    });
            }
            get();
        });
    </script>
{% endblock %}
